<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <AssemblyVersion>10.0.15</AssemblyVersion>
        <Version>10.0.15</Version>
        <Nullable>enable</Nullable>
        <Title>EFMaterializedPath</Title>
        <Authors>Meyhem</Authors>
        <Description>Library that provides simple materialized path tree structure for EF Entities</Description>
        <PackageProjectUrl>https://github.com/Meyhem/EFMaterializedPath</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Meyhem/EFMaterializedPath</RepositoryUrl>
        <RepositoryType>GIT</RepositoryType>
        <PackageTags>entityframework materialize path tree</PackageTags>
        <Copyright>Meyhem</Copyright>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReleaseNotes>Updated to .NET 10 and EF Core 10.0.15. Fixes: DetachNodeAsync/RemoveNodeAsync on PostgreSQL and SQL Server; SetParentAsync when moving a root with descendants; async enumeration of QueryAncestors on a root. Behaviour changes: SetParentAsync throws InvalidOperationException on cycles; untracked entities are attached and saved. Breaking: Query() and QueryRoots() return IQueryable&lt;TEntity&gt; (non-nullable elements). Breaking behaviour: DetachNodeAsync and RemoveNodeAsync save once instead of once per child. Added ValidateAsync, IsAncestorOf and IsDescendantOf. See the changelog in the README.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15"/>
    </ItemGroup>

</Project>
